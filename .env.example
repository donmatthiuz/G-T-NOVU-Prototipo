# Frontend: URL base, sin /v1. En Netlify se establece antes de compilar.
NEXT_PUBLIC_API_URL=http://localhost:8000
# La clave real permanece en .env y sólo la usa el backend.
API_GPT=
OPENAI_MODEL=gpt-5-mini
OPENAI_MAX_OUTPUT_TOKENS=1600
MONGODB_URI=mongodb://localhost:27017/novu?replicaSet=rs0&directConnection=true
MONGODB_DATABASE=novu
CORS_ORIGINS=http://localhost:3000,https://novu-prototipo-gt.netlify.app
# Vacío usa el disco local. En Cloud Run es obligatorio un bucket privado.
KYC_GCS_BUCKET=
SEED_DEMO_DATA=true
